  <property name="styleSheet">
   <string notr="true">QWidget {
    font-family: "Arial";
    font-size: 11pt;
    color: #1F2A37;
}
QMainWindow {
    background-color: #F4F8F7;
}
/* ---- Sidebar ---- */
#sidebarFrame {
    background-color: #0F766E;
}
#labelLogo {
    color: #FFFFFF;
    font-size: 20pt;
    font-weight: bold;
    padding: 18px 0px;
}
#sidebarFrame QPushButton {
    color: #FFFFFF;
    text-align: left;
    padding-left: 20px;
    border: none;
    background: transparent;
    font-size: 11pt;
    font-weight: bold;
}
#sidebarFrame QPushButton:hover {
    background-color: #0C5F58;
}
#sidebarFrame QPushButton:checked {
    background-color: #0B4F4A;
    border-left: 4px solid #F28C28;
}
/* ---- Page titles ---- */
#labelTitrePageAnimal, #labelTitrePageServices, #labelTitrePageRdv,
#labelTitrePageEmployes, #labelTitrePageStock {
    font-size: 20pt;
    font-weight: bold;
    color: #0B4F4A;
    padding-bottom: 4px;
}
/* ---- Inputs ---- */
QLineEdit, QComboBox, QDateEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #CBD5D3;
    border-radius: 6px;
    padding: 5px 8px;
}
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #0F766E;
}
QLineEdit:read-only {
    background-color: #EAF2F1;
    color: #5C6B69;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #CBD5D3;
    selection-background-color: #CDEAE6;
    selection-color: #1F2A37;
    outline: none;
}
/* ---- Scrollbars ---- */
QScrollBar:vertical {
    background: #F4F8F7;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #CBD5D3;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #9AA6A4;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
/* ---- Tables ---- */
QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #CBD5D3;
    border-radius: 8px;
    gridline-color: #E3EAE9;
}
QHeaderView::section {
    background-color: #0F766E;
    color: #FFFFFF;
    font-weight: bold;
    padding: 6px;
    border: none;
}
QTableWidget::item {
    padding: 4px;
}
QTableWidget::item:selected {
    background-color: #CDEAE6;
    color: #1F2A37;
}
/* ---- Action buttons (all modules) : Ajouter ---- */
#pushButtonAjouterAnimal, #pushButtonAjouterServices, #pushButtonAjouterRdv,
#pushButtonAjouterEmployes, #pushButtonAjouterStock, #pushButtonEnregistrerAnimal {
    background-color: #0F766E;
    color: #FFFFFF;
    font-weight: bold;
    border: none;
    border-radius: 6px;
}
#pushButtonAjouterAnimal:hover, #pushButtonAjouterServices:hover, #pushButtonAjouterRdv:hover,
#pushButtonAjouterEmployes:hover, #pushButtonAjouterStock:hover, #pushButtonEnregistrerAnimal:hover {
    background-color: #0C5F58;
}
/* ---- Modifier ---- */
#pushButtonModifierAnimal, #pushButtonModifierServices, #pushButtonModifierRdv,
#pushButtonModifierEmployes, #pushButtonModifierStock {
    background-color: #F28C28;
    color: #FFFFFF;
    font-weight: bold;
    border: none;
    border-radius: 6px;
}
#pushButtonModifierAnimal:hover, #pushButtonModifierServices:hover, #pushButtonModifierRdv:hover,
#pushButtonModifierEmployes:hover, #pushButtonModifierStock:hover {
    background-color: #E07B16;
}
/* ---- Supprimer ---- */
#pushButtonSupprimerAnimal, #pushButtonSupprimerServices, #pushButtonSupprimerRdv,
#pushButtonSupprimerEmployes, #pushButtonSupprimerStock {
    background-color: #C0392B;
    color: #FFFFFF;
    font-weight: bold;
    border: none;
    border-radius: 6px;
}
#pushButtonSupprimerAnimal:hover, #pushButtonSupprimerServices:hover, #pushButtonSupprimerRdv:hover,
#pushButtonSupprimerEmployes:hover, #pushButtonSupprimerStock:hover {
    background-color: #A5311F;
}
/* ---- Export / Statistiques ---- */
#pushButtonExporterPdfAnimal, #pushButtonStatistiquesAnimal,
#pushButtonExporterPdfServices, #pushButtonStatistiquesServices,
#pushButtonExporterPdfRdv, #pushButtonStatistiquesRdv,
#pushButtonExporterPdfEmployes, #pushButtonStatistiquesEmployes,
#pushButtonExporterPdfStock, #pushButtonStatistiquesStock {
    background-color: #0B4F4A;
    color: #FFFFFF;
    font-weight: bold;
    border: none;
    border-radius: 6px;
}
#pushButtonExporterPdfAnimal:hover, #pushButtonStatistiquesAnimal:hover,
#pushButtonExporterPdfServices:hover, #pushButtonStatistiquesServices:hover,
#pushButtonExporterPdfRdv:hover, #pushButtonStatistiquesRdv:hover,
#pushButtonExporterPdfEmployes:hover, #pushButtonStatistiquesEmployes:hover,
#pushButtonExporterPdfStock:hover, #pushButtonStatistiquesStock:hover {
    background-color: #083E3A;
}
/* ---- Innovative buttons (chatbot / rappels) ---- */
#pushButtonChatbotAnimal, #pushButtonRappelsSanteAnimal {
    background-color: #5C6B69;
    color: #FFFFFF;
    font-weight: bold;
    border: none;
    border-radius: 6px;
}
#pushButtonChatbotAnimal:hover, #pushButtonRappelsSanteAnimal:hover {
    background-color: #46524F;
}
/* ---- Annuler ---- */
#pushButtonAnnulerAnimal {
    background-color: #9AA6A4;
    color: #FFFFFF;
    font-size: 11pt;
    font-weight: bold;
    border: none;
    border-radius: 6px;
}
#pushButtonAnnulerAnimal:hover {
    background-color: #808C8A;
}
/* ---- Detail panel (Animaux form) ---- */
#frameDetailAnimal {
    background-color: #FFFFFF;
    border: 1px solid #CBD5D3;
    border-radius: 12px;
}
#labelDetailTitreAnimal {
    font-size: 13pt;
    font-weight: bold;
    color: #0B4F4A;
}
#labelChampIdAnimal, #labelChampNomAnimal, #labelChampEspeceAnimal, #labelChampSexeAnimal,
#labelChampNaissanceAnimal, #labelChampPhotoAnimal, #labelChampProprietaireAnimal,
#labelChampTelProprietaireAnimal, #labelChampEmailProprietaireAnimal {
    font-size: 9pt;
    font-weight: bold;
    color: #6B7A78;
}
#pushButtonChoisirPhotoAnimal {
    background-color: #EAF2F1;
    color: #0B4F4A;
    font-weight: bold;
    border: 1px solid #CBD5D3;
    border-radius: 6px;
}
#pushButtonChoisirPhotoAnimal:hover {
    background-color: #CDEAE6;
}</string>
