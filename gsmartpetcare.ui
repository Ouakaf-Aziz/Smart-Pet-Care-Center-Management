      <widget class="QWidget" name="pageVisage">
       <property name="windowTitle">
        <string>Reconnaissance faciale</string>
       </property>
       <property name="styleSheet">
        <string notr="true">#pageVisage { background-color: #F4F8F7; }
QWidget { font-family: "Arial"; font-size: 11pt; color: #1F2A37; }
#labelTitreVisage { font-size: 20pt; font-weight: bold; color: #0F766E; }
#labelApercu { color: #F4F8F7; background-color: #1F2A37; border-radius: 8px; }
#labelConsigne { color: #0F766E; }
#btnAnnulerVisage { background-color: #C0392B; color: #FFFFFF; border: none; }
#btnAnnulerVisage:hover { background-color: #A5311F; }
QProgressBar { border: 1px solid #CBD5D3; border-radius: 6px; background: #FFFFFF; text-align: center; height: 18px; }
QProgressBar::chunk { background-color: #0F766E; border-radius: 5px; }
QPushButton { background-color: #FFFFFF; color: #0F766E; border: 1px solid #0F766E;
              border-radius: 6px; padding: 8px 18px; }
QPushButton:hover { background-color: #E8F5F3; }
</string>
       </property>
