              <property name="styleSheet">
               <string notr="true">#pagePrivileges { background-color: #F4F8F7; }
          QWidget { font-family: "Arial"; font-size: 11pt; color: #1F2A37; }
          #titre { font-size: 20pt; font-weight: bold; color: #0F766E; }
          #aide { color: #1F2A37; }
          QTableWidget { background-color: #FFFFFF; alternate-background-color: #F4F8F7; border: 1px solid #CBD5D3;
                         border-radius: 8px; gridline-color: #E3EAE9; }
          QHeaderView::section { background-color: #0F766E; color: white; border: none; padding: 6px; font-weight: normal; }
          QCheckBox::indicator { width: 20px; height: 20px; }
          QPushButton { background-color: #0F766E; color: white; border: none;
                        border-radius: 6px; padding: 8px 18px; }
          QPushButton:hover { background-color: #0C5F58; }
          #btnAnnulerPrivileges { background-color: #C0392B; color: #FFFFFF; border: none; }
          #btnAnnulerPrivileges:hover { background-color: #A5311F; }
          </string>
