              </property>
              <property name="styleSheet">
               <string notr="true">QWidget { font-family: "Arial"; font-size: 11pt; color: #1F2A37; }
          #pageEmployes { background-color: #F4F8F7; }
          #labelTitrePageEmp { font-size: 20pt; font-weight: bold; color: #0F766E; }
          #labelUtilisateur { color: #1F2A37; }
          #labelDetailTitreEmp { color: #0F766E; }
          QLineEdit, QComboBox, QDateEdit {
              background-color: #FFFFFF; border: 1px solid #CBD5D3; border-radius: 6px; padding: 5px 8px;
          }
          QLineEdit:focus, QComboBox:focus, QDateEdit:focus { border: 2px solid #0F766E; }
          QLineEdit:read-only, QComboBox:disabled, QDateEdit:disabled { background-color: #E8F5F3; color: #1F2A37; }
          QComboBox::drop-down, QDateEdit::drop-down { border: none; width: 24px; }
          QComboBox QAbstractItemView {
              background-color: #FFFFFF; border: 1px solid #CBD5D3;
              selection-background-color: #CDEAE6; selection-color: #1F2A37; outline: none;
          }
          /* Turquoise : boutons principaux et validation */
          QPushButton {
              background-color: #0F766E; color: #FFFFFF; border: none;
              border-radius: 6px; padding: 8px 16px;
          }
          QPushButton:hover { background-color: #0C5F58; }
          /* Orange : actions importantes (Ajouter, Statistiques) */
          #btnAjouter, #btnStats { background-color: #F28C28; }
          #btnAjouter:hover, #btnStats:hover { background-color: #D97706; }
          /* Bleu : Modifier */
          #btnModifierLigne { background-color: #2F6FB3; }
          #btnModifierLigne:hover { background-color: #265A92; }
          /* Rouge : Supprimer */
          #btnSupprimerLigne { background-color: #C0392B; }
          #btnSupprimerLigne:hover { background-color: #A32F23; }
          /* Boutons secondaires (contour turquoise) */
          #btnVisage {
              background-color: #FFFFFF; color: #0F766E; border: 1px solid #0F766E;
          }
          #btnVisage:hover { background-color: #E8F5F3; }
          /* Rouge : Annuler */
          #btnAnnuler { background-color: #C0392B; color: #FFFFFF; border: none; }
          #btnAnnuler:hover { background-color: #A5311F; }
          #btnSupprVisage { background-color: #FFFFFF; color: #C0392B; border: 1px solid #C0392B; }
          #btnSupprVisage:hover { background-color: #FBEAE8; }
          #btnSupprVisage:disabled { color: #CBD5D3; border: 1px solid #CBD5D3; }
          #labelVisage { color: #1F2A37; }
          QTableWidget {
              background-color: #FFFFFF; alternate-background-color: #F4F8F7;
              border: 1px solid #CBD5D3; border-radius: 8px; gridline-color: #E3EAE9;
              selection-background-color: #CDEAE6; selection-color: #1F2A37;
          }
          QHeaderView::section {
              background-color: #0F766E; color: #FFFFFF; border: none; padding: 6px; font-weight: normal;
          }
          QMessageBox, QDialog { background-color: #F4F8F7; }
          QMessageBox QLabel { color: #1F2A37; }
          #frameDetailEmp { background-color: #FFFFFF; border: 1px solid #CBD5D3; border-radius: 12px; }
          #tableEmployes { font-size: 10pt; }
          #tableEmployes QHeaderView::section { font-size: 10pt; padding: 6px 2px; }
          #tableEmployes #btnModifierLigne, #tableEmployes #btnSupprimerLigne { font-size: 9pt; padding: 0 8px; }
          </string>
