              <property name="styleSheet">
               <string notr="true">#pageStatsEmployes { background-color: #F4F8F7; }
          QWidget { font-family: "Arial"; font-size: 11pt; color: #1F2A37; }
          #carteStatut, #cartePoste, #carteSalaire, #carteRecrutement { background-color: #FFFFFF; border: 1px solid #CBD5D3; border-radius: 12px; }
          #titrePage { font-size: 20pt; font-weight: bold; color: #0F766E; }
          #titreStatut, #titrePoste, #titreSalaire, #titreRecrutement { color: #0F766E; }
          QPushButton { background-color: #FFFFFF; color: #0F766E; border: 1px solid #0F766E;
                        border-radius: 6px; padding: 8px 18px; }
          QPushButton:hover { background-color: #E8F5F3; }
