            <widget class="QScrollArea" name="scrollAnimaux">
             <property name="frameShape">
              <enum>QFrame::Shape::NoFrame</enum>
             </property>
             <property name="widgetResizable">
              <bool>true</bool>
             </property>
             <widget class="QWidget" name="pageAnimaux">
              <property name="minimumSize">
               <size>
                <width>1100</width>
                <height>0</height>
               </size>
              </property>
              <property name="styleSheet">
               <string notr="true">QWidget {
    font-family: "Arial";
    font-size: 11pt;
    color: #1F2A37;
}
#pageAnimaux {
    background-color: #F4F8F7;
}
#labelTitrePageAnimal {
    font-size: 20pt;
    font-weight: bold;
    color: #0B4F4A;
    padding-bottom: 4px;
}
QLineEdit, QComboBox, QDateEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #CBD5D3;
    border-radius: 6px;
    padding: 5px 8px;
}
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #0F766E;
}
QLineEdit:read-only {
    background-color: #EAF2F1;
    color: #5C6B69;
}
QComboBox::drop-down, QDateEdit::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #CBD5D3;
    selection-background-color: #CDEAE6;
    selection-color: #1F2A37;
    outline: none;
}
QScrollBar:vertical {
    background: #F4F8F7;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #CBD5D3;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #9AA6A4;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #CBD5D3;
    border-radius: 8px;
    gridline-color: #E3EAE9;
}
QHeaderView::section {
    background-color: #0F766E;
    color: #FFFFFF;
    font-weight: bold;
    padding: 6px 4px;
    border: none;
}
QTableWidget::item {
    padding: 4px;
}
QTableWidget::item:selected {
    background-color: #CDEAE6;
    color: #1F2A37;
}
/* Ajouter / Enregistrer : turquoise */
#pushButtonAjouterAnimal, #pushButtonEnregistrerAnimal {
    background-color: #0F766E;
    color: #FFFFFF;
    font-weight: bold;
    border: none;
    border-radius: 6px;
}
#pushButtonAjouterAnimal:hover, #pushButtonEnregistrerAnimal:hover { background-color: #0C5F58; }
/* Modifier : orange */
#pushButtonModifierAnimal {
    background-color: #F28C28;
    color: #FFFFFF;
    font-weight: bold;
    border: none;
    border-radius: 6px;
}
#pushButtonModifierAnimal:hover { background-color: #E07B16; }
/* Supprimer : rouge */
#pushButtonSupprimerAnimal {
    background-color: #C0392B;
    color: #FFFFFF;
    font-weight: bold;
    border: none;
    border-radius: 6px;
}
#pushButtonSupprimerAnimal:hover { background-color: #A5311F; }
/* Exporter PDF / Statistiques */
#pushButtonExporterPdfAnimal {
    background-color: #0B4F4A;
    color: #FFFFFF;
    font-weight: bold;
    border: none;
    border-radius: 6px;
}
#pushButtonExporterPdfAnimal:hover { background-color: #083E3A; }
#pushButtonStatistiquesAnimal { background-color: #E67E22; color: white; font-weight: bold; border: none; border-radius: 6px; }
#pushButtonStatistiquesAnimal:hover { background-color: #CA6F1E; }
#pushButtonChatbotAnimal { background-color: #2471A3; color: white; font-weight: bold; border: none; border-radius: 6px; }
#pushButtonChatbotAnimal:hover { background-color: #1A5276; }
/* Prédiction */
#pushButtonRappelsSanteAnimal {
    background-color: #5C6B69;
    color: #FFFFFF;
    font-weight: bold;
    border: none;
    border-radius: 6px;
}
#pushButtonRappelsSanteAnimal:hover { background-color: #46524F; }
/* Annuler : ROUGE */
#pushButtonAnnulerAnimal {
    background-color: #C0392B;
    color: #FFFFFF;
    font-size: 11pt;
    font-weight: bold;
    border: none;
    border-radius: 6px;
}
#pushButtonAnnulerAnimal:hover { background-color: #A5311F; }
/* Panneau de détail */
#frameDetailAnimal {
    background-color: #FFFFFF;
    border: 1px solid #CBD5D3;
    border-radius: 12px;
}
#labelDetailTitreAnimal {
    font-size: 13pt;
    font-weight: bold;
    color: #0B4F4A;
}
#labelChampIdAnimal, #labelChampNomAnimal, #labelChampEspeceAnimal, #labelChampSexeAnimal,
#labelChampNaissanceAnimal, #labelChampPhotoAnimal, #labelChampProprietaireAnimal,
#labelChampTelProprietaireAnimal, #labelChampEmailProprietaireAnimal, #labelChampSuiviAnimal {
    font-size: 9pt;
    font-weight: bold;
    color: #6B7A78;
}
#pushButtonChoisirPhotoAnimal {
    background-color: #EAF2F1;
    color: #0B4F4A;
    font-weight: bold;
    border: 1px solid #CBD5D3;
    border-radius: 6px;
}
#pushButtonChoisirPhotoAnimal:hover { background-color: #CDEAE6; }</string>
              </property>
