              <property name="styleSheet">
               <string notr="true">QWidget {
            font-family: "Arial";
            font-size: 11pt;
            color: #1F2A37;
        }
        #pageServices {
            background-color: #F4F8F7;
        }
        #labelTitrePage {
            font-size: 20pt;
            font-weight: bold;
            color: #0B4F4A;
        }
        QLineEdit, QComboBox, QPlainTextEdit {
            background-color: #FFFFFF;
            border: 1px solid #CBD5D3;
            border-radius: 6px;
            padding: 5px 8px;
        }
        QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus {
            border: 2px solid #0F766E;
        }
        QLineEdit:read-only {
            background-color: #EAF2F1;
            color: #5C6B69;
        }
        QComboBox::drop-down {
            border: none;
            width: 24px;
        }
        QComboBox QAbstractItemView {
            background-color: #FFFFFF;
            border: 1px solid #CBD5D3;
            selection-background-color: #CDEAE6;
            selection-color: #1F2A37;
            outline: none;
        }
        QCheckBox {
            spacing: 8px;
        }
        QCheckBox::indicator {
            width: 18px;
            height: 18px;
            border: 1px solid #CBD5D3;
            border-radius: 4px;
            background-color: #FFFFFF;
        }
        QCheckBox::indicator:checked {
            background-color: #0F766E;
            border: 1px solid #0F766E;
        }
        QScrollBar:vertical {
            background: #F4F8F7;
            width: 10px;
            margin: 2px;
        }
        QScrollBar::handle:vertical {
            background: #CBD5D3;
            border-radius: 5px;
            min-height: 24px;
        }
        QScrollBar::handle:vertical:hover {
            background: #9AA6A4;
        }
        QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
            height: 0px;
        }
        #btnModifierLigne {
            background-color: #2F6FB3;
            color: #FFFFFF;
            font-size: 10pt;
            font-weight: bold;
            border: none;
            border-radius: 6px;
            padding: 0 12px;
        }
        #btnModifierLigne:hover { background-color: #255A93; }
        #btnSupprimerLigne {
            background-color: #C0392B;
            color: #FFFFFF;
            font-size: 10pt;
            font-weight: bold;
            border: none;
            border-radius: 6px;
            padding: 0 12px;
        }
        #btnSupprimerLigne:hover { background-color: #A5311F; }
        #pushButtonStatistiques {
            background-color: #F28C28;
            color: #FFFFFF;
            font-weight: bold;
            border: none;
            border-radius: 6px;
        }
        #pushButtonStatistiques:hover { background-color: #E07B16; }
        #pushButtonExporterPdf {
            background-color: #0B4F4A;
            color: #FFFFFF;
            font-weight: bold;
            border: none;
            border-radius: 6px;
        }
        #pushButtonExporterPdf:hover { background-color: #083E3A; }
        #pushButtonEnregistrer {
            background-color: #0F766E;
            color: #FFFFFF;
            font-size: 11pt;
            font-weight: bold;
            border: none;
            border-radius: 6px;
        }
        #pushButtonEnregistrer:hover { background-color: #0C5F58; }
        #pushButtonAnnuler {
            background-color: #C0392B;
            color: #FFFFFF;
            font-size: 11pt;
            font-weight: bold;
            border: none;
            border-radius: 6px;
        }
        #pushButtonAnnuler:hover { background-color: #A5311F; }
        #pushButtonHistorique {
            background-color: #2F6FB3;
            color: #FFFFFF;
            font-weight: bold;
            border: none;
            border-radius: 6px;
        }
        #pushButtonHistorique:hover { background-color: #255A93; }
        #frameDetail {
            background-color: #FFFFFF;
            border: 1px solid #CBD5D3;
            border-radius: 12px;
        }
        #labelDetailTitre {
            font-size: 13pt;
            font-weight: bold;
            color: #0B4F4A;
        }
        #labelChampId, #labelChampPrix, #labelChampNomService, #labelChampDescription, #labelChampDuree, #labelChampType {
            font-size: 9pt;
            font-weight: bold;
            color: #6B7A78;
        }
        QTableWidget {
            background-color: #FFFFFF;
            border: 1px solid #CBD5D3;
            border-radius: 8px;
            gridline-color: #E3EAE9;
        }
        QHeaderView::section {
            background-color: #0F766E;
            color: #FFFFFF;
            font-weight: bold;
            padding: 6px 4px;
            border: none;
        }
        QTableWidget::item {
            padding: 4px;
        }
        QTableWidget::item:selected {
            background-color: #CDEAE6;
            color: #1F2A37;
        }</string>
