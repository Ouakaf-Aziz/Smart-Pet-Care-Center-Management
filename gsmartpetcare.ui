              <property name="styleSheet">
               <string notr="true">QWidget {
            font-family: "Arial";
            font-size: 11pt;
            color: #1F2A37;
        }
        #pageRDV {
            background-color: #F4F8F7;
        }
        #labelTitrePageRdv {
            font-size: 20pt;
            font-weight: bold;
            color: #0B4F4A;
        }
        QLineEdit, QComboBox, QPlainTextEdit, QDateEdit, QTimeEdit, QSpinBox {
            background-color: #FFFFFF;
            border: 1px solid #CBD5D3;
            border-radius: 6px;
            padding: 5px 8px;
        }
        QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus, QDateEdit:focus, QTimeEdit:focus, QSpinBox:focus {
            border: 2px solid #0F766E;
        }
        QLineEdit:read-only {
            background-color: #EAF2F1;
            color: #5C6B69;
        }
        QComboBox::drop-down {
            border: none;
            width: 24px;
        }
        QComboBox QAbstractItemView {
            background-color: #FFFFFF;
            border: 1px solid #CBD5D3;
            selection-background-color: #CDEAE6;
            selection-color: #1F2A37;
            outline: none;
        }
        QCheckBox {
            spacing: 8px;
        }
        QCheckBox::indicator {
            width: 18px;
            height: 18px;
            border: 1px solid #CBD5D3;
            border-radius: 4px;
            background-color: #FFFFFF;
        }
        QCheckBox::indicator:checked {
            background-color: #0F766E;
            border: 1px solid #0F766E;
        }
        QScrollBar:vertical {
            background: #F4F8F7;
            width: 10px;
            margin: 2px;
        }
        QScrollBar::handle:vertical {
            background: #CBD5D3;
            border-radius: 5px;
            min-height: 24px;
        }
        QScrollBar::handle:vertical:hover {
            background: #9AA6A4;
        }
        QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
            height: 0px;
        }
        #btnModifierLigne {
            background-color: #2F6FB3;
            color: #FFFFFF;
            font-size: 10pt;
            font-weight: bold;
            border: none;
            border-radius: 6px;
            padding: 0 12px;
        }
        #btnModifierLigne:hover { background-color: #255A93; }
        #btnSupprimerLigne {
            background-color: #C0392B;
            color: #FFFFFF;
            font-size: 10pt;
            font-weight: bold;
            border: none;
            border-radius: 6px;
            padding: 0 12px;
        }
        #btnSupprimerLigne:hover { background-color: #A5311F; }
        #pushButtonStatistiquesRdv {
            background-color: #F28C28;
            color: #FFFFFF;
            font-weight: bold;
            border: none;
            border-radius: 6px;
        }
        #pushButtonStatistiquesRdv:hover { background-color: #E07B16; }
        #pushButtonExporterPdfRdv {
            background-color: #0B4F4A;
            color: #FFFFFF;
            font-weight: bold;
            border: none;
            border-radius: 6px;
        }
        #pushButtonExporterPdfRdv:hover { background-color: #083E3A; }
        #pushButtonEnregistrerRdv {
            background-color: #0F766E;
            color: #FFFFFF;
            font-size: 11pt;
            font-weight: bold;
            border: none;
            border-radius: 6px;
        }
        #pushButtonEnregistrerRdv:hover { background-color: #0C5F58; }
        #pushButtonAnnulerRdv {
            background-color: #C0392B;
            color: #FFFFFF;
            font-size: 11pt;
            font-weight: bold;
            border: none;
            border-radius: 6px;
        }
        #pushButtonAnnulerRdv:hover { background-color: #A5311F; }
        #pushButtonCalendrierRdv {
            background-color: #0F766E;
            color: #FFFFFF;
            font-weight: bold;
            border: none;
            border-radius: 6px;
        }
        #pushButtonCalendrierRdv:hover { background-color: #0C5F58; }
        #frameDetailRdv {
            background-color: #FFFFFF;
            border: 1px solid #CBD5D3;
            border-radius: 12px;
        }
        #labelDetailTitreRdv {
            font-size: 13pt;
            font-weight: bold;
            color: #0B4F4A;
        }
        #labelChampIdRdv, #labelChampDateRdv, #labelChampHeureRdv, #labelChampTypeRdv, #labelChampDureeRdv, #labelChampPrioriteRdv, #labelChampSalleRdv, #labelChampStatutRdv {
            font-size: 9pt;
            font-weight: bold;
            color: #6B7A78;
        }
        QTableWidget {
            background-color: #FFFFFF;
            border: 1px solid #CBD5D3;
            border-radius: 8px;
            gridline-color: #E3EAE9;
        }
        QHeaderView::section {
            background-color: #0F766E;
            color: #FFFFFF;
            font-weight: bold;
            padding: 6px 4px;
            border: none;
        }
        QTableWidget::item {
            padding: 4px;
        }
        QTableWidget::item:selected {
            background-color: #CDEAE6;
            color: #1F2A37;
        }
        #pushButtonConfirmerRdv {
            background-color: #F28C28;
            color: #FFFFFF;
            font-weight: bold;
            border: none;
            border-radius: 6px;
        }
        #pushButtonConfirmerRdv:hover { background-color: #E07B16; }
        #labelChampIdRdv, #labelChampDateRdv, #labelChampHeureRdv, #labelChampTypeRdv,
        #labelChampDureeRdv, #labelChampPrioriteRdv, #labelChampSalleRdv, #labelChampStatutRdv {
            padding-top: 8px;
        }
        QDateEdit::drop-down {
            border: none;
            width: 24px;
        }
        QDateEdit::down-arrow, QComboBox::down-arrow {
            image: url(:/images/arrow_down.png);
            width: 9px;
            height: 6px;
        }
        QSpinBox, QTimeEdit {
            padding-right: 22px;
        }
        QSpinBox::up-button, QTimeEdit::up-button {
            subcontrol-origin: border;
            subcontrol-position: top right;
            width: 20px;
            border: none;
        }
        QSpinBox::down-button, QTimeEdit::down-button {
            subcontrol-origin: border;
            subcontrol-position: bottom right;
            width: 20px;
            border: none;
        }
        QSpinBox::up-arrow, QTimeEdit::up-arrow {
            image: url(:/images/arrow_up.png);
            width: 9px;
            height: 6px;
        }
        QSpinBox::down-arrow, QTimeEdit::down-arrow {
            image: url(:/images/arrow_down.png);
            width: 9px;
            height: 6px;
        }
        #tableWidgetRdv {
            font-size: 10pt;
        }
        #tableWidgetRdv #btnModifierLigne, #tableWidgetRdv #btnSupprimerLigne {
            font-size: 9pt;
            padding: 0 6px;
        }</string>
