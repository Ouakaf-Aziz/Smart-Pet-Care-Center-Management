  <property name="styleSheet">
   <string notr="true">QWidget {
    font-family: &quot;Arial&quot;;
    font-size: 11pt;
    color: #1F2A37;
}
#centralwidget, #pageLogin, #pageAccueil {
    background-color: #F4F8F7;
}
#frameCard {
    background-color: #FFFFFF;
    border: 1px solid #CBD5D3;
    border-radius: 16px;
}
#labelTitre {
    font-size: 20pt;
    font-weight: bold;
    color: #0B4F4A;
}
#labelIdentifiant, #labelMotDePasse {
    font-size: 10pt;
    color: #6B7A78;
}
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #CBD5D3;
    border-radius: 6px;
    padding: 6px 10px;
}
QLineEdit:focus {
    border: 2px solid #0F766E;
}
#pushButtonConnexion {
    background-color: #F28C28;
    color: #FFFFFF;
    font-size: 12pt;
    font-weight: bold;
    border: none;
    border-radius: 8px;
}
#pushButtonConnexion:hover {
    background-color: #E07B16;
}
#pushButtonConnexion:pressed {
    background-color: #C96A0C;
}
#labelInfo {
    font-size: 9pt;
    color: #6B7A78;
}
#labelAccueil {
    font-size: 20pt;
    font-weight: bold;
    color: #0B4F4A;
}
#frameHeaderAccueil, #frameSidebar {
    background-color: #0F766E;
}
#labelHeaderTitre {
    color: #FFFFFF;
    font-size: 14pt;
    font-weight: bold;
}
#labelHeaderSous {
    color: #DCEEEC;
    font-size: 10pt;
}
#btnNavAccueil, #btnNavServices, #btnNavEmployes, #btnNavRDV, #btnNavAnimaux, #btnDeconnexion {
    background-color: transparent;
    color: #DCEEEC;
    font-size: 10pt;
    font-weight: bold;
    text-align: left;
    padding-left: 24px;
    border: none;
    border-left: 4px solid transparent;
}
#btnNavAccueil[actif="true"], #btnNavServices[actif="true"] {
    background-color: #0B5B55;
    color: #FFFFFF;
    border-left: 4px solid #F28C28;
}
#btnNavAccueil:hover, #btnNavServices:hover, #btnNavEmployes:hover, #btnNavRDV:hover, #btnNavAnimaux:hover:hover, #btnDeconnexion:hover {
    background-color: #0B5B55;
    color: #FFFFFF;
}
#lineSidebar {
    background-color: #2E8B84;
    max-height: 1px;
    border: none;
}
#labelBienvenue {
    font-size: 11pt;
    color: #6B7A78;
}
#cardService, #cardEmployes, #cardRDV, #cardAnimaux {
    background-color: #FFFFFF;
    border: 1px solid #CBD5D3;
    border-radius: 12px;
}
#accentService, #accentEmployes, #accentAnimaux {
    background-color: #F28C28;
}
#accentRDV {
    background-color: #0F766E;
}
#badgeService, #badgeRDV {
    background-color: #F28C28;
    color: #FFFFFF;
    font-size: 16pt;
    font-weight: bold;
    border-radius: 22px;
}
#badgeEmployes, #badgeAnimaux {
    background-color: #0F766E;
    color: #FFFFFF;
    font-size: 16pt;
    font-weight: bold;
    border-radius: 22px;
}
#titleService, #titleEmployes, #titleRDV, #titleAnimaux {
    font-size: 13pt;
    font-weight: bold;
    color: #1F2A37;
}</string>
